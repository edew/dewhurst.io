---
import { Hills } from "../components/hills";
import { StarField } from "../components/star-field";
import Document from "../layouts/Document.astro";
import { formatDate, getPosts, isoDate, postPath } from "../posts";

const posts = await getPosts();
---

<Document
  canonical="https://www.dewhurst.io"
  description="A blog for me"
  title="For Me"
>
  <Hills />
  <main>
    <header class="hero">
      <StarField />
      <h1>For Me</h1>
    </header>
    <ol class="posts">
      {
        posts.map((post) => (
          <li class="post">
            <time datetime={isoDate(post)}>{formatDate(post)}</time>
            <h2>
              <a href={postPath(post)}>{post.data.title}</a>
            </h2>
          </li>
        ))
      }
    </ol>
  </main>
</Document>
