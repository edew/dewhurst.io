---
import { StarField } from "../components/star-field";
import Document from "../layouts/Document.astro";
import { getPosts, isoDate, postPath } from "../posts";

const posts = await getPosts();
---

<Document canonical="/" description="A blog for me" title="For Me">
  <header class="sky">
    <StarField rows={5} />
    <h1 class="sky-title"><span>For Me</span></h1>
  </header>
  <main>
    <ol class="posts">
      {
        posts.map((post) => (
          <li>
            <time datetime={isoDate(post)}>{isoDate(post)}</time>
            <a href={postPath(post)}>{post.id}</a>
            <p>{post.data.description}</p>
          </li>
        ))
      }
    </ol>
  </main>
</Document>
